PORT=5000
MONGO_DB_URI=mongodb://127.0.0.1:27017/chitchat
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
# optional: enables Redis Pub/Sub (multi-instance) + shared presence. Without it the app runs single-instance in memory.
# REDIS_URL=redis://127.0.0.1:6379
# optional: send messages through Kafka; run `node backend/consumer.js` as a separate process to persist them.
# Without it the API writes straight to MongoDB.
# KAFKA_BROKERS=localhost:9094
# optional: comma separated extra origins allowed to open a socket (only needed if the client is served from another origin)
# CLIENT_ORIGIN=http://localhost:3000
